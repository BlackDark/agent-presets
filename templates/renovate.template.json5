// Template from BlackDark/agent-presets. Every repo gets a copy at .github/renovate.json5.
// The shared rules live in BlackDark/renovate-base (weekly, grouped non-major automerge, security
// fixes any time, npm release age, Conventional Commits, 0.x minors by hand, lock file maintenance). Keep only what
// this repo adds; delete rules for ecosystems it doesn't use.
// Repo settings: enable "Allow auto-merge" and require the CI status checks on main,
// otherwise platform automerge lands PRs before CI ran.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>blackdark/renovate-base//default.json5", // path after // is required for .json5
    // Go repos: also extend the go.mod/mise/golang-image grouping.
    // "github>blackdark/renovate-base//go.json5",
    // Rust repos: also extend the rust-toolchain.toml channel bump and Cargo handling.
    // "github>blackdark/renovate-base//rust.json5",
    ":pinVersions", // exact versions in package.json; libraries: remove, ranges belong there
  ],

  // With the weekly schedule, Renovate's own automerge only runs inside the window too, so a PR that
  // turns green later would wait a week. Platform automerge (GitHub native) merges it as soon as CI passes.
  updateNotScheduled: false,
  platformAutomerge: true,

  separateMultipleMajor: true,

  // Go: keep go.sum tidy (CI's `go mod tidy -diff` stays green); rewrite import paths on /vN majors.
  postUpdateOptions: ["gomodTidy", "gomodUpdateImportPaths"],

  // Later rules override earlier ones, and these override renovate-base: general first, specific after.
  packageRules: [
    {
      description: "Node runtime (mise + node images) in one PR",
      matchManagers: ["mise", "dockerfile", "docker-compose", "nodenv", "nvm"],
      matchPackageNames: ["node", "docker.io/library/node"],
      matchUpdateTypes: ["minor", "patch", "digest", "pinDigest"],
      groupName: "node runtime",
      groupSlug: "node-runtime",
      automerge: true,
    },
    {
      // Renovate flags packages without a release for a year (abandonments:recommended).
      // Finished micro-libs are not abandoned; list them with the reason, and add the repo's own.
      description: "Finished, dependency-free packages: no abandonment warning",
      matchPackageNames: [
        "clsx", // ~200 B className join, nothing left to add
        "class-variance-authority", // 0.7 stable, generated by shadcn/ui
      ],
      abandonmentThreshold: null,
    },
    {
      description: "Majors: one PR each, merged by hand",
      matchUpdateTypes: ["major"],
      addLabels: ["major"],
      automerge: false,
    },
    // Examples, copy and fill in when needed. Always say why and when to drop the rule.
    // {
    //   description: "Hold <pkg> below <x.y> until <upstream issue> is fixed",
    //   matchPackageNames: ["<pkg>"],
    //   allowedVersions: "<x.y.0",
    // },
    // {
    //   description: "Frozen on purpose: <reason>",
    //   matchPackageNames: ["<pkg>"],
    //   enabled: false,
    // },
  ],
}
