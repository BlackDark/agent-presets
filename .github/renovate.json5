// Shared rules from renovate-base; this repo adds GitHub Actions in snippets (scanned too, so
// copies start current) and platform automerge.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>blackdark/renovate-base//default.json5"], // ACTIONLINT_VERSION, RENOVATE_VERSION in lint.yml via its customManagers
  semanticCommits: "enabled",
  updateNotScheduled: false,
  platformAutomerge: true,

  "github-actions": {
    managerFilePatterns: ["/(^|/)snippets/.+\\.ya?ml$/"],
  },

  packageRules: [
    {
      description: "Majors: one PR each, merged by hand",
      matchUpdateTypes: ["major"],
      addLabels: ["major"],
      automerge: false,
    },
  ],
}
